# Copy to .env and fill in. Never commit .env.
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://rcmp_user:change_me@localhost:5432/rcmp
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
# Folder for encrypted uploads (C9). Keep outside version control.
FILE_STORAGE_DIR=./storage
# 32-byte key, base64 encoded, for file encryption. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_KEY=
