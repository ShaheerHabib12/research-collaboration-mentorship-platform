# Copy to .env (never commit .env). The server reads real environment variables;
# export them or load this file with your process manager (e.g. `node --env-file=.env server/index.js`).

# PostgreSQL connection (required when NODE_ENV=production)
# Supabase: use the Session pooler string plus ?sslmode=require (see supabase/README.md)
DATABASE_URL=postgres://rcmp:rcmp@localhost:5432/rcmp
PORT=3000

# Secrets: required in production, generated into ./data in development
RCMP_JWT_SECRET=            # >= 32 random characters
RCMP_FILE_KEY=              # 64 hex characters (AES-256 key for uploaded files)

# The real administrator, created on the first start (separate from the demo accounts).
# If RCMP_ADMIN_PASSWORD is empty a random one is printed once in the server log.
RCMP_ADMIN_EMAIL=muhammad.habib@myport.ac.uk
RCMP_ADMIN_NAME=Muhammad Habib
RCMP_ADMIN_PASSWORD=

# Folder for encrypted uploads and generated dev secrets
RCMP_DATA_DIR=./data

# Deployment behind a reverse proxy / load balancer
RCMP_FORCE_HTTPS=0          # 1 = redirect HTTP to HTTPS and send HSTS
RCMP_TRUST_PROXY=0          # 1 = trust X-Forwarded-For (only behind your own proxy)
RCMP_ALLOW_SIM=1            # 0 = disable demo tools and /api/demo/reset (always off in production)

# E-mail (verification PIN for new accounts, password-reset links). Empty = e-mail off and sign-up needs no PIN.
# See docs/EMAIL_SETUP.md. brevo | resend | console (console prints to the log: development only).
RCMP_MAIL_PROVIDER=
RCMP_MAIL_API_KEY=          # secret: set on the host, never commit
RCMP_MAIL_FROM=             # a sender address verified with the provider
RCMP_MAIL_FROM_NAME=RCMP
RCMP_PUBLIC_URL=            # https://your-app.onrender.com (used in password-reset e-mails)
RCMP_REQUIRE_VERIFY=0       # 1 = try verification locally with RCMP_MAIL_PROVIDER=console

RCMP_DB_POOL=10              # max PostgreSQL connections
RCMP_QUIET=0                # 1 = silence request logs

# Tests only
TEST_DATABASE_URL=postgres://rcmp:rcmp@localhost:5432/postgres
